struct IDXHeader
{
    char Identifier[4] <bgcolor=0xaaffaa>;
    
    short Version <bgcolor=0xffffaa>;
    
    short NumFiles <bgcolor=0xaaaaff>;
    
    uint32 FileSize <bgcolor=0xaaffff>;
    
    uint32 DataPointer <bgcolor=0xdfffff>;
    
    string Author;
} Header <bgcolor=0xaaaaff>;

typedef struct FolderEntry
{
    ushort StartIndex <bgcolor=0xccffcc>;
    ushort NumFiles <bgcolor=0xffccaa>;
};


FSeek(224);
struct IDXFolders
{
    // Size 108
    FolderEntry Entries[75];
    
} Folders <bgcolor=0xbbffbb>;

typedef struct IDXFile
{
    uint32 Pointer;
    uint32 Size;
    
    uint64 Compressed;
    
    char Name[32] <bgcolor=0xddddff>;
    
    local long pos = FTell();
    FSeek(Pointer);
    byte Data[Size];
    FSeek(pos);
};

FSeek(1056);
struct IDXFiles
{
    IDXFile Files[Header.NumFiles] <optimize=false>;
}Files <bgcolor=0xffaaaa>;





